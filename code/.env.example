# VERA-DREA settings. Copy this file to code/.env and fill in YOUR key:
#   Windows (from code\):  copy ..\.env.example .env
#   Mac/Linux (from code/): cp ../.env.example .env
# code/.env is git-ignored. Never commit it and never paste your key in Discord.

# --- OpenRouter: one key for every model we use -----------------------------
# We share Saksham's OpenRouter account. Saksham keeps using his own key;
# he creates one more key per teammate (each with its own credit limit)
# and sends it to you privately (DM).
# (Owner only: Keys -> Create Key; Credits -> Add Credits; Activity = spending.)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=sk-or-v1-replace-with-your-key

# Planner (main agent) and judge are chosen with --model from
# code/config/models.json and use the two OPENROUTER_ lines above:
#   deepseek-v3.2   -> deepseek/deepseek-v3.2   (Planner)
#   gpt-4.1-judge   -> openai/gpt-4.1           (judge for reasoning accuracy)

# Explorer (subagent) model. DREA reads these VLLM_ names; we point them at
# OpenRouter too, with the SAME key as above.
VLLM_BASE_URL=https://openrouter.ai/api/v1
VLLM_API_KEY=sk-or-v1-replace-with-your-key
VLLM_MODEL=deepseek/deepseek-v3.2

# --- Data locations ----------------------------------------------------------
# Relative to code/. On Windows keep these OUTSIDE OneDrive and pass
# --repos C:\vera-data\repos --dataset-dir C:\vera-data\dataset to run_batch.py.
DREA_DATASET_DIR=../dataset
DREA_REPO_CACHE_DIR=../repos
REPOPAIRBENCH_JSONL=../data/repopairbench_100.jsonl

# --- Optional: only for DREA's original main.py and other providers ----------
MAIN_BASE_URL=https://openrouter.ai/api/v1
MAIN_API_KEY=sk-or-v1-replace-with-your-key
MAIN_MODEL=deepseek/deepseek-v3.2
