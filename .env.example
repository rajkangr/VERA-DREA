# Main DREA agent. OpenAI-compatible endpoints work with ChatOpenAI.
MAIN_BASE_URL=https://api.openai.com/v1
MAIN_API_KEY=replace-with-your-key
MAIN_MODEL=gpt-4o

# Optional model registry entries in code/config/models.json.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=replace-with-your-key
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=replace-with-your-key
GEMINI_API_KEY=replace-with-your-key

# Explorer/subagent model. For local vLLM, EMPTY is commonly accepted.
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=EMPTY
VLLM_MODEL=replace-with-your-vllm-model

# Artifact paths used by the public scripts.
DREA_DATASET_DIR=../dataset
DREA_REPO_CACHE_DIR=../repos
REPOPAIRBENCH_JSONL=../data/repopairbench_100.jsonl
